{
  "project": {
    "name": "Lumos Casting Platform",
    "description": "A modern casting management platform with dark/light theme support",
    "brandName": "LUMOS",
    "primaryFont": "Orbitron",
    "secondaryFont": "Inter"
  },
  "designTokens": {
    "colors": {
      "dark": {
        "backgrounds": {
          "primary": "#000000",
          "secondary": "#0a0a0a",
          "tertiary": "#141414"
        },
        "text": {
          "primary": "#ffffff",
          "secondary": "#b0b0b0"
        },
        "accent": {
          "primary": "#dc143c",
          "secondary": "#8b0000",
          "glow": "rgba(220, 20, 60, 0.3)"
        },
        "borders": {
          "default": "rgba(220, 20, 60, 0.2)",
          "hover": "#dc143c"
        },
        "shadows": {
          "default": "rgba(220, 20, 60, 0.1)",
          "glow": "rgba(220, 20, 60, 0.3)"
        }
      },
      "light": {
        "backgrounds": {
          "primary": "#ffffff",
          "secondary": "#f8f8f8",
          "tertiary": "#f0f0f0"
        },
        "text": {
          "primary": "#0a0a0a",
          "secondary": "#666666"
        },
        "accent": {
          "primary": "#dc143c",
          "secondary": "#ff1744",
          "glow": "rgba(220, 20, 60, 0.15)"
        },
        "borders": {
          "default": "rgba(220, 20, 60, 0.3)",
          "hover": "#dc143c"
        },
        "shadows": {
          "default": "rgba(0, 0, 0, 0.1)"
        }
      },
      "semantic": {
        "success": {
          "gradient": "linear-gradient(135deg, #10b981, #059669)"
        },
        "error": {
          "gradient": "linear-gradient(135deg, #ef4444, #dc2626)"
        },
        "delete": {
          "gradient": "linear-gradient(135deg, #dc143c, #8b0000)"
        }
      }
    },
    "typography": {
      "fontFamilies": {
        "primary": "'Orbitron', sans-serif",
        "secondary": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
      },
      "fontSizes": {
        "xs": "0.75rem",
        "sm": "0.85rem",
        "base": "0.9rem",
        "md": "0.95rem",
        "lg": "1rem",
        "xl": "1.1rem",
        "2xl": "1.25rem",
        "3xl": "1.5rem",
        "4xl": "2rem",
        "5xl": "3rem"
      },
      "fontWeights": {
        "normal": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "lineHeights": {
        "tight": 1.4,
        "normal": 1.6,
        "relaxed": 1.8
      },
      "letterSpacing": {
        "tight": "0.5px",
        "normal": "1px",
        "wide": "2px"
      }
    },
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "0.75rem",
      "lg": "1rem",
      "xl": "1.5rem",
      "2xl": "2rem",
      "3xl": "3rem",
      "4xl": "4rem"
    },
    "borderRadius": {
      "sm": "6px",
      "md": "8px",
      "lg": "12px",
      "xl": "50px",
      "full": "50%"
    },
    "shadows": {
      "sm": "0 4px 12px rgba(0, 0, 0, 0.3)",
      "md": "0 10px 40px var(--shadow-color)",
      "lg": "0 10px 40px var(--accent-glow)",
      "xl": "0 15px 50px var(--accent-glow)",
      "2xl": "0 20px 60px rgba(0, 0, 0, 0.5)"
    },
    "transitions": {
      "fast": "0.2s ease",
      "normal": "0.3s ease",
      "slow": "0.6s cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "components": {
    "buttons": {
      "primary": {
        "background": "var(--accent-primary)",
        "border": "2px solid var(--accent-primary)",
        "borderRadius": "8px",
        "color": "white",
        "fontFamily": "'Orbitron', sans-serif",
        "fontSize": "1rem",
        "fontWeight": 600,
        "letterSpacing": "1px",
        "padding": "0.875rem 2rem",
        "textTransform": "uppercase",
        "hover": {
          "background": "var(--accent-secondary)",
          "borderColor": "var(--accent-secondary)",
          "boxShadow": "0 0 30px var(--accent-glow)",
          "transform": "translateY(-2px)"
        },
        "active": {
          "transform": "translateY(0)"
        }
      },
      "secondary": {
        "background": "transparent",
        "border": "1px solid var(--border-color)",
        "borderRadius": "8px",
        "color": "var(--text-primary)",
        "fontFamily": "'Inter', sans-serif",
        "fontSize": "0.9rem",
        "fontWeight": 500,
        "padding": "0.75rem 1.5rem",
        "hover": {
          "borderColor": "var(--accent-primary)",
          "color": "var(--accent-primary)",
          "boxShadow": "0 0 20px var(--accent-glow)"
        }
      },
      "normal": {
        "background": "transparent",
        "border": "2px solid var(--accent-primary)",
        "borderRadius": "50px",
        "color": "var(--accent-primary)",
        "fontFamily": "'Orbitron', sans-serif",
        "fontSize": "1rem",
        "fontWeight": 600,
        "letterSpacing": "1px",
        "padding": "1rem 3rem",
        "textTransform": "uppercase",
        "hover": {
          "color": "var(--bg-primary)",
          "boxShadow": "0 0 30px var(--accent-glow)",
          "transform": "translateY(-2px)",
          "fillAnimation": "scale from center"
        }
      },
      "danger": {
        "background": "var(--accent-primary)",
        "border": "2px solid var(--accent-primary)",
        "borderRadius": "8px",
        "color": "white",
        "fontFamily": "'Orbitron', sans-serif",
        "fontSize": "1rem",
        "fontWeight": 600,
        "letterSpacing": "0.5px",
        "padding": "0.875rem 2rem",
        "hover": {
          "background": "var(--accent-secondary)",
          "borderColor": "var(--accent-secondary)",
          "boxShadow": "0 0 30px var(--accent-glow)",
          "transform": "translateY(-2px)"
        }
      },
      "back": {
        "position": "fixed",
        "top": "90px",
        "left": "2rem",
        "zIndex": 100,
        "background": "var(--accent-primary)",
        "border": "2px solid var(--accent-primary)",
        "borderRadius": "8px",
        "color": "white",
        "fontFamily": "'Orbitron', sans-serif",
        "fontSize": "0.85rem",
        "fontWeight": 600,
        "letterSpacing": "0.5px",
        "padding": "0.625rem 1.25rem",
        "textTransform": "uppercase",
        "icon": "arrow-left",
        "iconSize": "16px",
        "gap": "0.5rem",
        "mobile": {
          "top": "80px",
          "left": "1rem",
          "padding": "0.5rem 1rem",
          "fontSize": "0.8rem",
          "iconSize": "14px"
        }
      }
    },
    "cards": {
      "default": {
        "background": "var(--bg-secondary)",
        "border": "1px solid var(--border-color)",
        "borderRadius": "12px",
        "padding": "1.5rem",
        "hover": {
          "borderColor": "var(--accent-primary)",
          "boxShadow": "0 10px 40px var(--shadow-color)"
        }
      },
      "clickable": {
        "extends": "default",
        "cursor": "pointer",
        "hover": {
          "transform": "translateY(-5px)",
          "boxShadow": "0 15px 50px var(--accent-glow)"
        }
      },
      "performer": {
        "background": "var(--bg-secondary)",
        "border": "1px solid var(--border-color)",
        "borderRadius": "12px",
        "overflow": "hidden",
        "display": "flex",
        "flexDirection": "column",
        "image": {
          "aspectRatio": "3/4",
          "background": "var(--bg-tertiary)",
          "objectFit": "cover"
        },
        "info": {
          "padding": "1.5rem"
        },
        "title": {
          "fontFamily": "'Orbitron', sans-serif",
          "fontSize": "1.25rem",
          "fontWeight": 600,
          "color": "var(--text-primary)",
          "marginBottom": "0.75rem"
        },
        "details": {
          "fontSize": "0.9rem",
          "color": "var(--text-secondary)",
          "gap": "0.5rem"
        },
        "actions": {
          "padding": "0 1.5rem 1.5rem",
          "gap": "0.75rem"
        },
        "hover": {
          "borderColor": "var(--accent-primary)",
          "boxShadow": "0 10px 40px var(--accent-glow)",
          "transform": "translateY(-5px)",
          "imageScale": "1.05"
        },
        "selected": {
          "borderColor": "var(--accent-primary)",
          "boxShadow": "0 0 0 3px var(--accent-glow)",
          "animation": "selectPulse 0.4s ease-out",
          "badge": {
            "position": "absolute",
            "top": "12px",
            "right": "12px",
            "background": "var(--accent-primary)",
            "color": "white",
            "width": "40px",
            "height": "40px",
            "borderRadius": "50%",
            "icon": "checkmark"
          }
        }
      }
    },
    "forms": {
      "input": {
        "width": "100%",
        "background": "var(--bg-tertiary)",
        "border": "1px solid var(--border-color)",
        "borderRadius": "8px",
        "padding": "0.875rem 1rem",
        "fontFamily": "'Inter', sans-serif",
        "fontSize": "1rem",
        "color": "var(--text-primary)",
        "focus": {
          "borderColor": "var(--accent-primary)",
          "boxShadow": "0 0 0 3px var(--accent-glow)"
        },
        "placeholder": {
          "color": "var(--text-secondary)",
          "opacity": 0.5
        }
      },
      "select": {
        "extends": "input"
      },
      "textarea": {
        "extends": "input",
        "minHeight": "120px",
        "resize": "vertical"
      },
      "label": {
        "display": "block",
        "fontFamily": "'Inter', sans-serif",
        "fontSize": "0.9rem",
        "fontWeight": 500,
        "color": "var(--text-secondary)",
        "marginBottom": "0.5rem",
        "letterSpacing": "0.5px"
      }
    },
    "navbar": {
      "position": "fixed",
      "top": 0,
      "left": 0,
      "right": 0,
      "zIndex": 1000,
      "height": "80px",
      "background": "var(--bg-primary)",
      "backdropFilter": "blur(10px)",
      "borderBottom": "1px solid var(--border-color)",
      "padding": "0 4rem",
      "logo": {
        "height": "50px",
        "hover": {
          "transform": "scale(1.05)",
          "filter": "drop-shadow(0 0 20px var(--accent-glow))"
        }
      },
      "links": {
        "gap": "2.5rem",
        "fontSize": "0.95rem",
        "fontWeight": 500,
        "letterSpacing": "0.5px",
        "underline": {
          "height": "2px",
          "background": "var(--accent-primary)",
          "animation": "width from 0 to 100%"
        },
        "hover": {
          "color": "var(--accent-primary)"
        }
      },
      "themeToggle": {
        "background": "var(--bg-tertiary)",
        "border": "1px solid var(--border-color)",
        "borderRadius": "50%",
        "width": "40px",
        "height": "40px",
        "hover": {
          "background": "var(--accent-primary)",
          "borderColor": "var(--accent-primary)",
          "transform": "rotate(180deg)",
          "boxShadow": "0 0 20px var(--accent-glow)"
        }
      },
      "mobile": {
        "height": "70px",
        "padding": "0 1.5rem",
        "logoHeight": "40px",
        "linksGap": "1.5rem",
        "fontSize": "0.85rem"
      }
    },
    "modals": {
      "confirm": {
        "overlay": {
          "background": "rgba(0, 0, 0, 0.75)",
          "zIndex": 10000,
          "animation": "fadeIn 0.2s ease"
        },
        "content": {
          "background": "var(--bg-secondary)",
          "border": "1px solid var(--border-color)",
          "borderRadius": "12px",
          "padding": "2rem",
          "maxWidth": "450px",
          "width": "90%",
          "boxShadow": "0 20px 60px rgba(0, 0, 0, 0.5)",
          "animation": "slideUp 0.3s ease"
        },
        "icon": {
          "width": "48px",
          "height": "48px",
          "color": "var(--accent-primary)",
          "marginBottom": "1.5rem"
        },
        "title": {
          "fontFamily": "'Orbitron', sans-serif",
          "fontSize": "1.5rem",
          "fontWeight": 600,
          "color": "var(--text-primary)",
          "marginBottom": "1rem"
        },
        "message": {
          "fontFamily": "'Inter', sans-serif",
          "fontSize": "1rem",
          "color": "var(--text-secondary)",
          "lineHeight": 1.6,
          "marginBottom": "2rem"
        },
        "actions": {
          "gap": "1rem",
          "buttonMaxWidth": "150px"
        },
        "mobile": {
          "padding": "1.5rem",
          "maxWidth": "90%",
          "titleFontSize": "1.25rem",
          "messageFontSize": "0.95rem",
          "actionsFlexDirection": "column",
          "buttonMaxWidth": "100%"
        }
      },
      "performer": {
        "extends": "confirm"
      }
    },
    "toast": {
      "position": "fixed",
      "top": "100px",
      "left": "50%",
      "transform": "translateX(-50%)",
      "minWidth": "300px",
      "maxWidth": "500px",
      "padding": "1rem 1.5rem",
      "borderRadius": "8px",
      "boxShadow": "0 10px 40px rgba(0, 0, 0, 0.3)",
      "zIndex": 9999,
      "animation": "slideDown 0.3s ease forwards",
      "fontFamily": "'Inter', sans-serif",
      "types": {
        "success": {
          "background": "linear-gradient(135deg, #10b981, #059669)",
          "color": "white"
        },
        "error": {
          "background": "linear-gradient(135deg, #ef4444, #dc2626)",
          "color": "white"
        },
        "delete": {
          "background": "linear-gradient(135deg, #dc143c, #8b0000)",
          "color": "white"
        }
      },
      "icon": {
        "width": "24px",
        "height": "24px"
      },
      "message": {
        "fontSize": "0.95rem",
        "fontWeight": 500,
        "lineHeight": 1.4
      },
      "undoButton": {
        "background": "rgba(255, 255, 255, 0.2)",
        "border": "1px solid rgba(255, 255, 255, 0.3)",
        "borderRadius": "6px",
        "color": "white",
        "fontFamily": "'Orbitron', sans-serif",
        "fontSize": "0.85rem",
        "fontWeight": 600,
        "padding": "0.5rem 1rem",
        "textTransform": "uppercase",
        "letterSpacing": "0.5px",
        "hover": {
          "background": "rgba(255, 255, 255, 0.3)",
          "borderColor": "rgba(255, 255, 255, 0.5)",
          "transform": "translateY(-1px)"
        }
      },
      "closeButton": {
        "color": "white",
        "opacity": 0.8,
        "hover": {
          "opacity": 1
        }
      },
      "mobile": {
        "top": "90px",
        "minWidth": "calc(100% - 2rem)",
        "maxWidth": "calc(100% - 2rem)",
        "left": "1rem",
        "transform": "translateX(0)"
      }
    }
  },
  "layouts": {
    "pageContainer": {
      "minHeight": "100vh",
      "paddingTop": "80px"
    },
    "contentWrapper": {
      "maxWidth": "1400px",
      "margin": "0 auto",
      "padding": "2rem",
      "mobile": {
        "padding": "1rem"
      }
    },
    "grids": {
      "grid2": {
        "display": "grid",
        "gridTemplateColumns": "repeat(auto-fit, minmax(300px, 1fr))",
        "gap": "2rem"
      },
      "grid3": {
        "display": "grid",
        "gridTemplateColumns": "repeat(auto-fit, minmax(250px, 1fr))",
        "gap": "1.5rem"
      },
      "grid4": {
        "display": "grid",
        "gridTemplateColumns": "repeat(auto-fit, minmax(200px, 1fr))",
        "gap": "1.5rem"
      },
      "performersGrid": {
        "display": "grid",
        "gridTemplateColumns": "repeat(auto-fill, minmax(280px, 1fr))",
        "gap": "1.5rem",
        "mobile": {
          "gridTemplateColumns": "1fr"
        }
      }
    }
  },
  "animations": {
    "fadeIn": {
      "from": {
        "opacity": 0
      },
      "to": {
        "opacity": 1
      },
      "duration": "0.2s",
      "easing": "ease"
    },
    "fadeInUp": {
      "from": {
        "opacity": 0,
        "transform": "translateY(30px)"
      },
      "to": {
        "opacity": 1,
        "transform": "translateY(0)"
      },
      "duration": "0.8s",
      "easing": "ease"
    },
    "slideDown": {
      "from": {
        "opacity": 0,
        "transform": "translateX(-50%) translateY(-100%)"
      },
      "to": {
        "opacity": 1,
        "transform": "translateX(-50%) translateY(0)"
      },
      "duration": "0.3s",
      "easing": "ease"
    },
    "slideUp": {
      "from": {
        "opacity": 0,
        "transform": "translateY(20px)"
      },
      "to": {
        "opacity": 1,
        "transform": "translateY(0)"
      },
      "duration": "0.3s",
      "easing": "ease"
    },
    "slideIn": {
      "from": {
        "opacity": 0,
        "transform": "translateY(20px)"
      },
      "to": {
        "opacity": 1,
        "transform": "translateY(0)"
      },
      "duration": "0.3s",
      "easing": "ease-out"
    },
    "selectPulse": {
      "keyframes": [
        {
          "offset": "0%",
          "transform": "scale(1)"
        },
        {
          "offset": "50%",
          "transform": "scale(1.05)"
        },
        {
          "offset": "100%",
          "transform": "scale(1)"
        }
      ],
      "duration": "0.4s",
      "easing": "ease-out"
    },
    "pulse": {
      "keyframes": [
        {
          "offset": "0%",
          "opacity": 1
        },
        {
          "offset": "50%",
          "opacity": 0.5
        },
        {
          "offset": "100%",
          "opacity": 1
        }
      ],
      "duration": "2s",
      "easing": "cubic-bezier(0.4, 0, 0.6, 1)",
      "iteration": "infinite"
    },
    "shimmer": {
      "from": {
        "backgroundPosition": "0% center"
      },
      "to": {
        "backgroundPosition": "200% center"
      }
    }
  },
  "pages": {
    "home": {
      "hero": {
        "title": "LUMOS",
        "subtitle": "Modern Casting Management",
        "ctaButton": "Get Started"
      }
    },
    "adminDashboard": {
      "title": "Admin Dashboard",
      "cards": [
        {
          "title": "Performers Gallery",
          "description": "Manage performer profiles and portfolios",
          "icon": "users"
        },
        {
          "title": "Generate Client Link",
          "description": "Create access links for clients",
          "icon": "link"
        },
        {
          "title": "Casting Orders",
          "description": "View finalized casting selections",
          "icon": "list"
        },
        {
          "title": "Email Management",
          "description": "Manage communications",
          "icon": "mail"
        },
        {
          "title": "Preview Client View",
          "description": "See what clients see",
          "icon": "eye"
        }
      ]
    },
    "performers": {
      "title": "Performers",
      "hasBackButton": true,
      "addButton": "Add Performer",
      "cardLayout": "grid",
      "cardContent": {
        "image": "3:4 aspect ratio",
        "name": "full name",
        "details": ["gender", "height"],
        "contact": "email",
        "actions": ["Edit", "Delete"]
      },
      "deleteFlow": {
        "step1": {
          "title": "Delete Performer",
          "message": "Are you sure you want to delete this performer?",
          "buttons": ["Yes", "No"]
        },
        "step2": {
          "title": "Confirm Deletion",
          "message": "This action is permanent and cannot be undone. Are you absolutely sure you want to delete this performer?",
          "buttons": ["Yes, Delete Permanently", "No, Go Back"]
        },
        "toast": {
          "type": "delete",
          "message": "[Name] has been deleted",
          "undoAction": true
        }
      }
    },
    "castingOrders": {
      "title": "Casting Orders",
      "hasBackButton": true,
      "cardLayout": "grid-2",
      "cardContent": {
        "companyName": "header",
        "commercialDescription": "body",
        "performerCount": "count",
        "finalizedDate": "timestamp"
      },
      "cardInteraction": "clickable"
    },
    "castingOrderDetail": {
      "title": "Company Name",
      "hasBackButton": true,
      "sections": [
        {
          "type": "header",
          "content": {
            "companyName": "title",
            "finalizedDate": "subtitle"
          }
        },
        {
          "type": "info",
          "title": "Commercial Description",
          "content": "description text"
        },
        {
          "type": "performerGrid",
          "title": "Selected Performers (count)",
          "layout": "grid",
          "cardContent": {
            "image": "3:4 aspect ratio",
            "name": "full name",
            "details": ["gender", "age", "height"],
            "attributes": ["hair color", "eye color"],
            "contact": ["email", "phone"]
          }
        }
      ]
    },
    "clientPortal": {
      "header": {
        "companyName": "title",
        "commercialDescription": "subtitle",
        "castingCounter": {
          "badge": "circular count",
          "text": "Selected",
          "finalizeButton": "Finalize Casting"
        }
      },
      "filters": {
        "layout": "grid",
        "fields": [
          "search by name",
          "gender select",
          "min age",
          "max age",
          "hair color",
          "eye color",
          "min height",
          "max height"
        ],
        "clearButton": "Clear Filters"
      },
      "resultsInfo": "Showing X of Y performers",
      "performersGrid": {
        "layout": "auto-fill minmax(280px, 1fr)",
        "reordering": "selected first, animated",
        "cardContent": {
          "image": "3:4 aspect ratio",
          "selectedBadge": "checkmark circle overlay",
          "name": "full name",
          "details": ["gender", "age", "height"],
          "attributes": ["hair color", "eye color"],
          "actions": ["View Details", "Select/Remove"]
        },
        "selectedState": {
          "border": "accent-primary with glow",
          "animation": "selectPulse",
          "reorder": "move to beginning"
        }
      }
    }
  },
  "iconography": {
    "style": "outline/stroke",
    "strokeWidth": "2px",
    "sizes": {
      "sm": "16px",
      "md": "20px",
      "lg": "24px",
      "xl": "48px"
    },
    "icons": [
      "arrow-left",
      "checkmark",
      "close (X)",
      "warning-triangle",
      "trash",
      "success-circle",
      "error-circle",
